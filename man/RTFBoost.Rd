\examples{

data(fruitfly)
n  <- nrow(fruitfly$eggs)
n0 <- floor(0.2 * n)
set.seed(123)
idx_test  <- sample(n, n0)
idx_train <- sample((1:n)[-idx_test], floor(0.6 * n))
idx_val   <- (1:n)[-c(idx_test, idx_train)]
xtrain <- fruitfly$eggs[idx_train, ]
ytrain <- fruitfly$lifetime[idx_train]
xval   <- fruitfly$eggs[idx_val, ]
yval   <- fruitfly$lifetime[idx_val]
xtest  <- fruitfly$eggs[idx_test, ]
ytest  <- fruitfly$lifetime[idx_test]
gg <- 1:30
tt <- c(0, 30)
# For illustrative purposes only; in practice, more iterations (niter),
# directions (num.dir) may be required for convergence.
niter <- 10
tree.control <- TREE.control(tree.type = "B", max.depth = 1, num.dir = 20)

# LAD loss
my.control <- RTFBoost.control(make.prediction = TRUE, save.tree = TRUE,
                               tree.control = tree.control, shrinkage = 0.05,
                               nknot = 3, type = "LAD")
model_TFBoost <- RTFBoost(x.train = xtrain, y.train = ytrain,
                          x.val = xval, y.val = yval,
                          grid = gg, t.range = tt, niter = niter,
                          control = my.control)
predictions_LAD <- RTFBoost.predict(model_TFBoost, newx = xtest,
                                    grid = gg, t.range = tt)

\donttest{
